{
  "name": "dsh-skill-panel",
  "version": "0.2.0",
  "private": true,
  "description": "Skills button for the DeepSeek Harness sidebar: browse the session skill catalog with Chinese descriptions, search, keyboard navigation and recent picks.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skills",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maomaobishop/dsh-skill-panel.git"
  },
  "homepage": "https://github.com/maomaobishop/dsh-skill-panel#readme",
  "bugs": {
    "url": "https://github.com/maomaobishop/dsh-skill-panel/issues"
  },
  "author": "maomaobishop",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "install.ps1",
    "uninstall.ps1"
  ],
  "scripts": {
    "test": "node test/render.mjs && node test/interact.mjs && node test/storm2.mjs no-using ok && node test/storm2.mjs using-reject ok"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  }
}

